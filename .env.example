# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server (cron gửi mail). KHÔNG đưa lên client, KHÔNG commit.
SUPABASE_SERVICE_ROLE_KEY=

# Giờ mở khoá lấy trực tiếp từ settings.unlock_at trong DB qua unlock_info.
# Gợi ý hiện ở ô mật mã khi đăng nhập
NEXT_PUBLIC_LOGIN_HINT=Mật mã là ngày đặc biệt của tụi mình (ddmmyyyy)

# Gửi mail bằng Gmail (miễn phí, ~500 mail/ngày). Cần bật xác minh 2 bước rồi tạo
# Mật khẩu ứng dụng tại https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Tên người gửi hiện trong hộp thư
MAIL_FROM_NAME=min vakre blomst
# Địa chỉ web sau khi deploy, dùng để chèn link vào mail
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chuỗi bí mật bất kỳ, dịch vụ cron phải gửi kèm: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
